APP_ENV=development

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql://chordsync:chordsync@localhost:5432/chordsync

REDIS_URL=redis://localhost:6379/0

STORAGE_PATH=./storage

# Cloud-ready persistence composition. Local remains the default and requires
# no AWS configuration. AWS mode uses the normal AWS credential provider chain.
CHORDSYNC_RUNTIME_MODE=local
AWS_REGION=
CHORDSYNC_S3_BUCKET=
CHORDSYNC_DYNAMODB_JOB_TABLE=
CHORDSYNC_DISPATCH_MODE=in_process
CHORDSYNC_SQS_ANALYSIS_QUEUE_URL=

# Added later
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Remote ML worker
ML_WORKER_URL=

# Optional when sonic-annotator is not available on PATH.
CHORDSYNC_SONIC_ANNOTATOR=/path/to/sonic-annotator

# Optional worker/container path overrides. Repository-local development paths
# remain the defaults when these variables are unset.
CHORDSYNC_WORKSPACE_ROOT=/tmp/chordsync
CHORDSYNC_API_PYTHON=/opt/chordsync/api/bin/python
CHORDSYNC_BEAT_PYTHON=/opt/chordsync/beats/bin/python
CHORDSYNC_WHISPERX_EXECUTABLE=/opt/chordsync/whisperx/bin/whisperx
CHORDSYNC_DEMUCS_EXECUTABLE=/opt/chordsync/demucs/bin/demucs

# Optional internal neural chord-estimator configuration. Chordino is default.
CHORDSYNC_CHORD_ESTIMATOR=chordino
CHORDSYNC_BTC_PYTHON=/path/to/.venv-btc/bin/python
CHORDSYNC_BTC_SOURCE=/path/to/BTC-ISMIR19
CHORDSYNC_BTC_CHECKPOINT=/path/to/btc_model.pt

# Optional multilingual WhisperX detection and Latin-script lyric display.
# Disabled by default so the established English pipeline remains unchanged.
CHORDSYNC_MULTILINGUAL_LYRICS_ENABLED=0
