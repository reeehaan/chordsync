APP_ENV=development

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql://chordsync:chordsync@localhost:5432/chordsync

REDIS_URL=redis://localhost:6379/0

STORAGE_PATH=./storage

# Added later
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Remote ML worker
ML_WORKER_URL=

# Optional when sonic-annotator is not available on PATH.
CHORDSYNC_SONIC_ANNOTATOR=/path/to/sonic-annotator

# Optional internal neural chord-estimator configuration. Chordino is default.
CHORDSYNC_CHORD_ESTIMATOR=chordino
CHORDSYNC_BTC_PYTHON=/path/to/.venv-btc/bin/python
CHORDSYNC_BTC_SOURCE=/path/to/BTC-ISMIR19
CHORDSYNC_BTC_CHECKPOINT=/path/to/btc_model.pt
